{
  "openapi": "3.1.0",
  "info": {
    "title": "University Schedule Integration API",
    "version": "1.0.0",
    "description": "Публичный read-only API расписания. Текущая инсталляция: ФЗО РГАТУ."
  },
  "paths": {
    "/api/v1/meta": {
      "get": {
        "summary": "Метаданные инсталляции и расписания",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/groups": {
      "get": {
        "summary": "Список групп",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/teachers": {
      "get": {
        "summary": "Список преподавателей",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/schedule": {
      "get": {
        "summary": "Расписание группы или преподавателя",
        "parameters": [
          {
            "name": "group",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "teacher",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Нужен group или teacher"
          },
          "404": {
            "description": "Не найдено"
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "summary": "OpenAPI-контракт",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}
